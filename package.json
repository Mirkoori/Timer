{
  "name": "palco-timer",
  "version": "0.1.0",
  "description": "Timer da palco per eventi: scaletta, schermo relatore, messaggi, sincronizzazione in rete locale",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "desktop": "electron .",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "main": "electron/main.js",
  "author": "Mirko",
  "homepage": "https://github.com/Mirkoori/Timer",
  "build": {
    "appId": "it.mirkoori.palcotimer",
    "productName": "Palco Timer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server.js",
      "public/**",
      "package.json",
      "!public/**/*.map"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1040"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "public/icon.png"
    }
  }
}
